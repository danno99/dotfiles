#!/bin/bash

# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
set -euo pipefail

echo "Checking for new packages to install on CachyOS..."

# 1. Update system databases and install official repo packages
sudo pacman -Syu --needed --noconfirm \
{{ range .packages.cachyos.pacman -}}
  {{ . }} \
{{ end }}

# 2. Install AUR helper (paru) if not present, then install AUR packages
if ! command -v paru &> /dev/null; then
    echo "paru not found. Installing AUR packages via pacman if available or skipping..."
else
    paru -S --needed --noconfirm \
    {{ range .packages.cachyos.aur -}}
      {{ . }} \
{{ end }}
fi

echo "Software installation sync complete!"
