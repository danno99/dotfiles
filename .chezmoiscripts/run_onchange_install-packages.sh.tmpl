#!/bin/bash

# Change-detection trigger: embed the SHA256 of packages.yaml in a comment so
# the rendered script only changes (and chezmoi re-runs it) when the manifest
# or this template changes — not on every `chezmoi apply` (official chezmoi
# pattern: "Run a script when the contents of another file changes").
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
set -euo pipefail

CURRENT_USER="${USER:-$(id -un)}"
echo "Checking for new packages to install on CachyOS..."

# ---------------------------------------------------------------------------
# 1. Default shell: switch to bash if the login shell isn't already
# ---------------------------------------------------------------------------
user_shell="$(getent passwd "$CURRENT_USER" | cut -d: -f7)"
if [ "$user_shell" != "/usr/bin/bash" ] && [ "$user_shell" != "/bin/bash" ]; then
    echo "  -> Setting default shell to bash..."
    if [ -t 0 ]; then
        chsh -s /usr/bin/bash "$CURRENT_USER" || true
    else
        echo "  -> Non-interactive session, skipping chsh."
    fi
fi

# ---------------------------------------------------------------------------
# 2. Chaotic-AUR binary repo (idempotent: runs only once, if not registered)
#    Precompiled builds of popular AUR packages (incl. paru itself), so they
#    install via plain pacman instead of being built from source.
#    Official setup flow: https://aur.chaotic.cx/docs
# ---------------------------------------------------------------------------
if ! grep -qxF '[chaotic-aur]' /etc/pacman.conf 2>/dev/null; then
    echo "  -> Registering Chaotic-AUR repo..."
    # Import + trust the Chaotic-AUR signing key (keyserver, then vendor copy)
    if ! sudo pacman-key --finger 3056513887B78AEB &>/dev/null; then
        # keyserver.ubuntu.com (what the Chaotic docs use) is a SKS-pool
        # successor that has fallen out of sync with the network, so fall
        # back to keys.openpgp.org, then to the vendor-published key file.
        sudo pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com \
          || sudo pacman-key --recv-key 3056513887B78AEB --keyserver keys.openpgp.org \
          || { curl -fsSL https://raw.githubusercontent.com/chaotic-aur/chaotic-aur.github.io/master/chaotic.gpg -o /tmp/chaotic.gpg
               sudo pacman-key --import /tmp/chaotic.gpg
               rm -f /tmp/chaotic.gpg; }
        sudo pacman-key --lsign-key 3056513887B78AEB
    fi
    # Their keyring + mirrorlist packages (provides /etc/pacman.d/chaotic-mirrorlist)
    sudo pacman -U --noconfirm \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'
    # Append at the end so official repos keep priority
    printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' | sudo tee -a /etc/pacman.conf
fi

# ---------------------------------------------------------------------------
# 3. Official repo packages — FULL sync+upgrade (pacman -Syu).
#    A full upgrade keeps the whole pacman system (official + Chaotic-AUR) at
#    one consistent state, avoiding the partial-upgrade breakage that a
#    DB-refresh-and-only-some-packages (-Sy) install can cause. The manifest
#    packages are listed so missing ones install; --needed skips the
#    already-present ones (no spurious "up to date -- reinstalling"). NOTE:
#    this is a full system upgrade with --noconfirm — heavier and unattended
#    by design, but the hash trigger above limits it to manifest changes.
# ---------------------------------------------------------------------------
pacman_pkgs=({{ range .packages.cachyos.pacman }}{{ . | quote }} {{ end }})
if [ ${#pacman_pkgs[@]} -gt 0 ]; then
    sudo pacman -Syu --needed --noconfirm "${pacman_pkgs[@]}"
fi

# ---------------------------------------------------------------------------
# 4. AUR packages (genuinely AUR-only — not in any pacman repo). Built via
#    paru. The `pacman -Si` pre-check is a safety net: if an entry is ever
#    resolvable from a configured repo (e.g. newly added to Chaotic-AUR), it
#    installs precompiled instead of being built from source.
# ---------------------------------------------------------------------------
aur_candidates=({{ range .packages.cachyos.aur }}{{ . | quote }} {{ end }})
chaotic_pkgs=()
aur_only=()
for p in "${aur_candidates[@]}"; do
    if pacman -Si "$p" &>/dev/null; then
        chaotic_pkgs+=("$p")
    else
        aur_only+=("$p")
    fi
done

if [ ${#chaotic_pkgs[@]} -gt 0 ]; then
    echo "  -> Precompiled via Chaotic-AUR: ${chaotic_pkgs[*]}"
    sudo pacman -S --needed --noconfirm "${chaotic_pkgs[@]}"
fi

if [ ${#aur_only[@]} -gt 0 ]; then
    if command -v paru &>/dev/null; then
        echo "  -> Installing AUR-only packages: ${aur_only[*]}"
        paru -S --needed --noconfirm "${aur_only[@]}"
    else
        echo "  -> WARNING: paru not found, skipping AUR packages: ${aur_only[*]}" >&2
    fi
fi

# ---------------------------------------------------------------------------
# 5. Remove unneeded packages (the `remove` list in packages.yaml — e.g.
#    distro defaults like fish that you don't want). Stateless + idempotent:
#    the check is the package DB itself (only act if currently installed).
#    -c cascades to packages that depend on the target (e.g.
#    cachyos-fish-config, fisher, fish-pure-prompt, fish-autopair when
#    removing fish); -n also drops any dependency nothing else needs.
#    Deps that other packages still use (e.g. fzf, which is in the install
#    list) are kept.
#    Works for repo AND AUR packages alike (removal is local — no repo
#    lookup).
#    Runs AFTER install, so the install list always wins on a conflict.
# ---------------------------------------------------------------------------
remove_candidates=({{ range .packages.cachyos.remove }}{{ . | quote }} {{ end }})
removed=()
for p in "${remove_candidates[@]}"; do
    if ! pacman -Q "$p" &>/dev/null; then
        echo "  -> $p not installed. Skipping."
        continue
    fi
    echo "  -> Removing $p..."
    sudo pacman -Rcn --noconfirm "$p"
    removed+=("$p")
done
if [ ${#removed[@]} -gt 0 ]; then
    echo "  -> Removed: ${removed[*]}"
fi

# ---------------------------------------------------------------------------
# 6. GNOME dark color scheme (only if gsettings exists and session D-Bus is available)
# ---------------------------------------------------------------------------
if command -v gsettings &>/dev/null && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
fi

# ---------------------------------------------------------------------------
# 7. Ryzen SMU + ASUS ROG Flow Z13 first-time setup.
#    State-checked against the real persistent artifact (modules-load.d), so
#    the one-shot z13ctl settings only apply when the module is first set up.
#    (z13ctl-bin is installed from AUR in step 4, which runs before this.)
# ---------------------------------------------------------------------------
if ! grep -qxF "ryzen_smu" /etc/modules-load.d/ryzen_smu.conf 2>/dev/null; then
    echo "  -> First-time Ryzen SMU / Z13 setup..."
    sudo modprobe ryzen_smu 2>/dev/null || true
    echo "ryzen_smu" | sudo tee -a /etc/modules-load.d/ryzen_smu.conf >/dev/null
    if command -v z13ctl &>/dev/null; then
        z13ctl batterylimit --set 60 || true
        z13ctl apply --color gold --brightness low || true
        z13ctl profile --set performance || true
        z13ctl autoswitch --ac performance || true
    fi
fi

# ---------------------------------------------------------------------------
# 8. llama-api user service (idempotent)
# ---------------------------------------------------------------------------
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR/systemd" ]; then
    systemctl --user daemon-reload || true
    for svc in llama-server.service kev-server.service; do
        if systemctl --user list-unit-files "$svc" &>/dev/null; then
            systemctl --user enable "$svc" || true
            systemctl --user start "$svc" || true
        fi
    done
fi

# ---------------------------------------------------------------------------
# 9. ly config tweaks (idempotent seds)
# ---------------------------------------------------------------------------
if [ -f /etc/ly/config.ini ]; then
    sudo sed -i 's/^animation = .*/animation = matrix/' /etc/ly/config.ini
    sudo sed -i 's/^bigclock = .*/bigclock = en/' /etc/ly/config.ini
fi

# ---------------------------------------------------------------------------
# 10. Wi-Fi: ignore auto-DNS (persistent on active Wi-Fi connection)
# ---------------------------------------------------------------------------
active_wifi="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | awk -F: '$2 ~ /wireless|wifi/ { print $1; exit }' || true)"
if [ -n "$active_wifi" ]; then
    nmcli connection modify "$active_wifi" ipv4.ignore-auto-dns yes || true
else
    echo "  -> No active Wi-Fi connection found, skipping auto-DNS setting."
fi

# ---------------------------------------------------------------------------
# 11. EasyEffects presets (JackHack96's collection; `echo 1` = "install all").
#     Guard: install once any preset exists — in the EasyEffects 8+ data dir
#     (~/.local/share/easyeffects) OR the 7.x config dir (~/.config/...);
#     the installer itself picks the right directory.
# ---------------------------------------------------------------------------
if ! compgen -G "${XDG_DATA_HOME:-$HOME/.local/share}/easyeffects/output/*.json" >/dev/null 2>&1 && \
   ! compgen -G "${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/output/*.json" >/dev/null 2>&1; then
    echo "  -> Installing EasyEffects presets..."
    preset_script="$(curl -fsSL https://raw.githubusercontent.com/JackHack96/EasyEffects-Presets/master/install.sh || true)"
    if [ -n "$preset_script" ]; then
        echo 1 | bash -c "$preset_script" || true
    fi
fi

# ---------------------------------------------------------------------------
# 12. Append configuration only if it doesn't already exist
# ---------------------------------------------------------------------------
if [ -d /etc/libvirt ]; then
    if [ -f /etc/libvirt/network.conf ] && grep -Eq '^\s*firewall_backend\s*=\s*"iptables"' /etc/libvirt/network.conf; then
        echo "  -> Firewall backend already set to iptables. Skipping."
    else
        echo "  -> Configuring firewall backend..."
        echo 'firewall_backend = "iptables"' | sudo tee -a /etc/libvirt/network.conf >/dev/null
    fi
fi

# ---------------------------------------------------------------------------
# 13. Safely handle the directory creation and chattr attributes
# ---------------------------------------------------------------------------
if [ ! -d /var/lib/libvirt/images ]; then
    echo "  -> Creating libvirt images directory..."
    sudo mkdir -p /var/lib/libvirt/images
fi

# Check if the NOCOW (+C) attribute is already applied (valid on Btrfs systems).
if [ "$(findmnt -T /var/lib/libvirt/images -no FSTYPE 2>/dev/null)" = "btrfs" ]; then
    if lsattr -d /var/lib/libvirt/images 2>/dev/null | awk '{print $1}' | grep -q C; then
        echo "  -> NOCOW (+C) attribute already set on images directory. Skipping."
    else
        echo "  -> Setting NOCOW (+C) attribute..."
        sudo chattr +C /var/lib/libvirt/images 2>/dev/null || true
    fi
fi

# ---------------------------------------------------------------------------
# 14. Enable and start services only if they aren't active/enabled
# ---------------------------------------------------------------------------
for service in libvirtd.service libvirtd.socket; do
    if systemctl is-enabled --quiet "$service" 2>/dev/null && systemctl is-active --quiet "$service" 2>/dev/null; then
        echo "  -> Service $service is already running and enabled. Skipping."
    else
        echo "  -> Starting and enabling $service..."
        sudo systemctl enable --now "$service" || true
    fi
done

# ---------------------------------------------------------------------------
# 15. Safely configure and start the default network (idempotent).
# ---------------------------------------------------------------------------
_default_net_state() { sudo virsh net-list --all 2>/dev/null | awk '$1 == "default" { print $2 }'; }
_default_net_autostart() { sudo virsh net-list --all 2>/dev/null | awk '$1 == "default" { print $3 }'; }

if [ "$(_default_net_state)" = "active" ]; then
    echo "  -> libvirt default network is already active. Skipping."
elif [ -n "$(_default_net_state)" ]; then
    echo "  -> Starting default network..."
    if ! sudo virsh net-start default; then
        if [ "$(_default_net_state)" = "active" ]; then
            echo "  -> Network became active during start attempt. Continuing."
        else
            echo "  -> WARNING: could not activate the default libvirt network." >&2
        fi
    fi
else
    echo "  -> Default libvirt network not defined. Skipping net-start."
fi

if [ "$(_default_net_autostart)" = "yes" ]; then
    echo "  -> libvirt default network autostart already enabled. Skipping."
elif [ -n "$(_default_net_state)" ]; then
    echo "  -> Setting default network to autostart..."
    sudo virsh net-autostart default || true
fi

for grp in libvirt render audio video; do
    if getent group "$grp" &>/dev/null; then
        sudo usermod -aG "$grp" "$CURRENT_USER"
    fi
done

# ---------------------------------------------------------------------------
# 16. AMDGPU DPM high performance udev rule (locks GPU core/memory clocks)
# ---------------------------------------------------------------------------
if [ ! -f /etc/udev/rules.d/99-amdgpu-performance.rules ]; then
    echo "  -> Setting up AMDGPU DPM high performance udev rule..."
    sudo tee /etc/udev/rules.d/99-amdgpu-performance.rules << 'EOF'
ACTION=="add", SUBSYSTEM=="pci", DRIVER=="amdgpu", ATTR{power_dpm_force_performance_level}="high"
EOF
    sudo udevadm control --reload-rules && sudo udevadm trigger -s pci -c add || true
fi

echo "Software installation sync complete"
