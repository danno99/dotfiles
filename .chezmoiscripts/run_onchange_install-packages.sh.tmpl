#!/bin/bash

# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
set -euo pipefail

echo "Checking for new packages to install on CachyOS..."

# ---------------------------------------------------------------------------
# 1. Chaotic-AUR binary repo (idempotent: runs only once, if not registered)
#    Precompiled builds of popular AUR packages (incl. paru itself), so they
#    install via plain pacman instead of being built from source.
#    Official setup flow: https://aur.chaotic.cx/docs
# ---------------------------------------------------------------------------
if ! grep -qxF '^\[chaotic-aur\]' /etc/pacman.conf; then
    echo "  -> Registering Chaotic-AUR repo..."
    # Import + trust the Chaotic-AUR signing key (keyserver, then vendor copy)
    if ! sudo pacman-key --finger 3056513887B78AEB &>/dev/null; then
        sudo pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com \
          || { curl -fsSL https://raw.githubusercontent.com/chaotic-aur/chaotic-aur.github.io/master/chaotic.gpg -o /tmp/chaotic.gpg
               sudo pacman-key --import /tmp/chaotic.gpg
               rm -f /tmp/chaotic.gpg; }
        sudo pacman-key --lsign-key 3056513887B78AEB
    fi
    # Their keyring + mirrorlist packages (provides /etc/pacman.d/chaotic-mirrorlist)
    sudo pacman -U --noconfirm \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' \
        'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'
    # Append at the end so official repos keep priority
    printf '\n[chaotic-aur]\nInclude = /etc/pacman.d/chaotic-mirrorlist\n' | sudo tee -a /etc/pacman.conf
fi

# ---------------------------------------------------------------------------
# 2. Official repo packages (DB refresh only — no implicit full upgrade).
#    System upgrades stay a deliberate manual step: run `paru -Syu` yourself
#    (covers official + AUR + Chaotic-AUR packages).
# ---------------------------------------------------------------------------
sudo pacman -Sy --needed --noconfirm {{ range .packages.cachyos.pacman }}{{ . }} {{ end }}

# ---------------------------------------------------------------------------
# 3. AUR packages, split automatically:
#    - resolvable from a configured repo (incl. chaotic-aur) -> pacman (precompiled)
#    - everything else -> built from AUR with paru
# ---------------------------------------------------------------------------
chaotic_pkgs=()
aur_only=()
for p in {{ range .packages.cachyos.aur }}{{ . }} {{ end }}; do
    if pacman -Si "$p" &>/dev/null; then
        chaotic_pkgs+=("$p")
    else
        aur_only+=("$p")
    fi
done

if [ ${#chaotic_pkgs[@]} -gt 0 ]; then
    echo "  -> Precompiled via Chaotic-AUR: ${chaotic_pkgs[*]}"
    sudo pacman -S --needed --noconfirm "${chaotic_pkgs[@]}"
fi

if [ ${#aur_only[@]} -gt 0 ]; then
    if command -v paru &>/dev/null; then
        echo "  -> Building from AUR: ${aur_only[*]}"
        paru -S --needed --noconfirm "${aur_only[@]}"
    else
        echo "  -> WARNING: paru not found, skipping AUR packages: ${aur_only[*]}" >&2
    fi
fi

# 4. GNOME dark color scheme (only if gsettings exists on this system)
if command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
fi

# 5. Ryzen SMU + ThinkPad Z13 first-time setup.
#    State-checked against the real persistent artifact (modules-load.d), so
#    the one-shot z13ctl settings only apply when the module is first set up.
#    (z13ctl-bin is installed from AUR in step 3, which runs before this.)
if ! grep -qxF "ryzen_smu" /etc/modules-load.d/ryzen_smu.conf 2>/dev/null; then
    echo "  -> First-time Ryzen SMU / Z13 setup..."
    sudo modprobe ryzen_smu
    echo "ryzen_smu" | sudo tee -a /etc/modules-load.d/ryzen_smu.conf
    if command -v z13ctl &>/dev/null; then
        z13ctl batterylimit --set 60
        z13ctl apply --color gold --brightness low
    fi
fi

systemctl --user daemon-reload
systemctl --user enable --now llama-api.socket

# 6. ly config tweaks (idempotent seds)
sudo sed -i 's/^animation = none$/animation = matrix/' /etc/ly/config.ini
sudo sed -i 's/^bigclock = none$/bigclock = en/' /etc/ly/config.ini

# 7. Wi-Fi: ignore auto-DNS (first Wi-Fi device — no hardcoded interface name)
wlan_dev="$(nmcli -t -f DEVICE device wifi 2>/dev/null | head -n1 || true)"
if [ -n "$wlan_dev" ]; then
    nmcli device modify "$wlan_dev" ipv4.ignore-auto-dns yes
else
    echo "  -> No Wi-Fi device found, skipping auto-DNS setting."
fi

# 8. EasyEffects presets (vendored, pinned installer — no curl|bash at runtime)
if [ ! -d ~/.config/easyeffects ]; then
    echo 1 | bash "{{ .chezmoi.sourceDir }}/.chezmoitemplates/easyeffects-install.sh"
fi

# 9. Append configuration only if it doesn't already exist
if [ -f /etc/libvirt/network.conf ] && grep -Fq 'firewall_backend = "iptables"' /etc/libvirt/network.conf; then
    echo "  -> Firewall backend already set to iptables. Skipping."
else
    echo "  -> Configuring firewall backend..."
    echo 'firewall_backend = "iptables"' | sudo tee -a /etc/libvirt/network.conf
fi

# 10. Safely handle the directory creation and chattr attributes
if [ ! -d /var/lib/libvirt/images ]; then
    echo "  -> Creating libvirt images directory..."
    sudo mkdir -p /var/lib/libvirt/images
fi

# Check if the NOCOW (+C) attribute is already applied (common on Btrfs systems)
if lsattr -d /var/lib/libvirt/images 2>/dev/null | grep -q -- '[-i][-a]C'; then
    echo "  -> NOCOW (+C) attribute already set on images directory. Skipping."
else
    echo "  -> Setting NOCOW (+C) attribute..."
    sudo chattr +C /var/lib/libvirt/images
fi

# 11. Enable and start services only if they aren't active/enabled
for service in libvirtd.service libvirtd.socket; do
    if systemctl is-enabled --quiet "$service" && systemctl is-active --quiet "$service"; then
        echo "  -> Service $service is already running and enabled. Skipping."
    else
        echo "  -> Starting and enabling $service..."
        sudo systemctl enable --now "$service"
    fi
done

# 12. Safely configure and start the default network
# Check if default network is active
if sudo virsh net-info default 2>/dev/null | grep -qE "Active:\s+yes"; then
    echo "  -> libvirt default network is already active. Skipping."
else
    echo "  -> Starting default network..."
    sudo virsh net-start default
fi

# Check if default network is set to autostart
if sudo virsh net-info default 2>/dev/null | grep -qE "Autostart:\s+yes"; then
    echo "  -> libvirt default network autostart already enabled. Skipping."
else
    echo "  -> Setting default network to autostart..."
    sudo virsh net-autostart default
fi

sudo usermod -aG libvirt,render,audio,video $USER

echo "Software installation sync complete"
