#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# --- 1. SMART TAB-COMPLETION & CORRECTIONS ------------------------------------
# Case-insensitive tab completion (typing 'cd doc' will find 'Documents')
bind "set completion-ignore-case on"

# Show all matching tab completions immediately on the first press
bind "set show-all-if-ambiguous on"

# Automatically fix minor typos in directory names when using 'cd'
shopt -s cdspell

# Enable advanced programmable completion patterns if installed on the OS
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# --- 2. UPGRADED FISH-STYLE ARROW HISTORY SEARCH ------------------------------
# Type the beginning of a command and press Up/Down to filter history matching it
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# Boost history retention size
export HISTSIZE=500000
export HISTFILESIZE=500000

# Avoid logging consecutive duplicate commands or lines starting with spaces
export HISTCONTROL=ignoreboth

# PI Local Models
export PI_LOCAL_MODELS=1

# Instantly append commands to history file upon execution and save changes
shopt -s histappend
PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

# --- 3. SAFETY NETS & UTILITIES -----------------------------------------------
# Default editor
export EDITOR=nvim
export SUDO_EDITOR=nvim

# Prevent overwriting an existing file via standard output redirection ('>')
set -o noclobber

# Check window size after each command and update rows/columns if resized
shopt -s checkwinsize

# --- 4. VISUAL READABILITY & COLORIZED PROMPT ---------------------------------
# Colorize default terminal output lists and match searches
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ll='ls -lah --color=auto'

# Editor aliases
alias vi='nvim'
alias vim='nvim'

# Run pi via mise
alias pi='mise run pi'

# Fuzzy Finder (CTRL-r)
command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

prompt_details() {
  local rc=$? path=$PWD branch i
  local -a parts

  [[ $path == "$HOME" || $path == "$HOME/"* ]] &&
    path="~${path#"$HOME"}"

  IFS=/ read -r -a parts <<< "$path"
  for ((i=0; i<${#parts[@]}-1; i++)); do
    [[ -z ${parts[i]} || ${parts[i]} == '~' ]] && continue
    if [[ ${parts[i]} == .* ]]; then
      parts[i]=${parts[i]:0:2}
    else
      parts[i]=${parts[i]:0:1}
    fi
  done

  local IFS=/
  path=${parts[*]}
  printf '%s' "${path:-/}"

  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  [[ -n $branch ]] && printf ' [%s]' "$branch"

  if (( rc != 0 )); then
    printf ' \001\033[31m\002[%d]\001\033[0m\002' "$rc"
  else
    printf ' [%d]' "$rc"
  fi
}

export PS1='\[\e[36m\]\t \[\e[33;1m\]$(prompt_details)\[\e[m\] \$ '
