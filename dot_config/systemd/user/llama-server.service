[Unit]
Description=llama.cpp Local Server (Qwen3.8-27B HauhauCS Q5_K_P MTP)
After=network.target

[Service]
Type=exec
Environment="RADV_PERFTEST=nogttspill"
Environment="GGML_VK_PREFER_HOST_MEMORY=1"
LimitMEMLOCK=infinity

ExecStart=/usr/bin/llama-server \
    --model %h/.local/share/models/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q5_K_P.gguf \
    --alias qwen-local \
    --host 127.0.0.1 \
    --port 8080 \
    --device Vulkan0 \
    --n-gpu-layers all \
    --fit off \
    --ctx-size 131072 \
    --parallel 1 \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    --cache-type-k-draft q4_0 \
    --cache-type-v-draft q4_0 \
    --ctx-checkpoints 16 \
    --cache-ram 0 \
    --batch-size 2048 \
    --ubatch-size 512 \
    --load-mode mlock \
    --threads 16 \
    --threads-batch 16 \
    --flash-attn on \
    --jinja \
    --reasoning on \
    --reasoning-preserve \
    --temp 1.0 \
    --top-p 0.95 \
    --top-k 20 \
    --min-p 0 \
    --presence-penalty 0 \
    --repeat-penalty 1.0 \
    --spec-type draft-mtp \
    --spec-draft-n-max 4 \
    --sleep-idle-seconds 600

TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
