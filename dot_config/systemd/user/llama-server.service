[Unit]
Description=Local llama.cpp server
StopWhenUnneeded=true

[Service]
Type=exec
ExecStart=llama-server --model %h/.local/share/models/Swift-1.5-Qwen3.8-27B-Uncensored-Dynamic-MTP-UD-Q6_K_XL.gguf --alias qwen-local --host 127.0.0.1 --port 8081 --device Vulkan0 -ngl 99 --ctx-size 131072 --cache-type-k q8_0 --cache-type-v q8_0 --threads 16 --threads-batch 16 --parallel 1 --flash-attn on --jinja --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0 --repeat-penalty 1.0 --spec-type draft-mtp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
