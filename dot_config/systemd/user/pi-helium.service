[Unit]
Description=Helium Browser for Pi Agent
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/helium-browser --user-data-dir=%h/.local/share/pi-helium --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
