# Shared Baseline Configuration for llama.cpp on AMD Strix Halo
# -----------------------------------------------------------------
# Network & Identity Defaults
HOST=127.0.0.1
PORT=8080
ALIAS=%i

# Compute & Device (AMD Radeon 8060S / Strix Halo Vulkan)
DEVICE=Vulkan0
N_GPU_LAYERS=all
FIT=off
PARALLEL=1
THREADS=16
THREADS_BATCH=16
FLASH_ATTN=on
SLEEP_IDLE_SECONDS=600

# Aggressive Context, Cache & Memory Tuning Mantra:
# - 131k context with Q4_0 KV cache
# - Context checkpoints (SWA) to dramatically cut VRAM
# - Zero RAM cache (--cache-ram 0) and mlock to keep everything pinned in fast unified memory
CTX_SIZE=131072
TUNING_ARGS=--cache-type-k q4_0 --cache-type-v q4_0 --ctx-checkpoints 16 --cache-ram 0 --batch-size 2048 --ubatch-size 512 --load-mode mlock

# Multi-Token Prediction (MTP) Speculative Decoding
MTP_ARGS=--spec-type draft-mtp --spec-draft-n-max 4 --cache-type-k-draft q4_0 --cache-type-v-draft q4_0

# Reasoning & Sampling Defaults
SAMPLING_ARGS=--jinja --reasoning on --reasoning-preserve --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0 --repeat-penalty 1.0

EXTRA_ARGS=
